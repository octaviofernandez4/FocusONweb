PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/<db-name>
JWT_SECRET=<a-long-random-secret>
# Clave para encriptar credenciales guardadas (ej. contraseña de aplicación de
# Gmail) — tiene que ser DISTINTA del JWT_SECRET y no rotarse a la ligera
# (rotarla vuelve indescifrables las credenciales ya guardadas).
CREDENTIALS_ENCRYPTION_KEY=<another-long-random-secret-different-from-jwt-secret>
# Acepta uno o varios orígenes separados por coma (ej. producción + preview de Vercel):
# FRONTEND_URL=https://app.tudominio.com,https://tu-proyecto.vercel.app
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>
# Gmail "del sistema" (no de una empresa en particular) que manda los emails
# de recuperación de contraseña — necesita su propia contraseña de aplicación,
# igual que el email de notificaciones que carga cada empresa en Configuración.
# Sin esto, "olvidé mi contraseña" sigue sin poder mandar el link (se loguea el aviso, no rompe nada).
SYSTEM_EMAIL_USER=<tu-cuenta-del-sistema@gmail.com>
SYSTEM_EMAIL_APP_PASSWORD=<contraseña-de-aplicación-de-16-caracteres>
